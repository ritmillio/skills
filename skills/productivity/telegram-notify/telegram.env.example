# Telegram notification config for Claude Code.  chmod 600 — never commit this.
# Install to ~/.claude/telegram.env (override with $CLAUDE_TELEGRAM_ENV).
#
# 1. Talk to @BotFather in Telegram -> /newbot -> copy the token here.
# 2. Send your new bot any message, then run:
#      curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#        | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"][-1]["message"]["chat"]["id"])'
#    and copy the chat id here. A group chat id is negative.
# 3. Verify:  ~/.claude/telegram-notify.sh --doctor
#
# Both values must be non-empty or every notification is a silent no-op.

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- knobs (all optional) ---------------------------------------------------
# Turns shorter than this never ping. Raise it if the phone buzzes too much.
TELEGRAM_MIN_TURN_SECONDS=120

TELEGRAM_NOTIFY_COMMIT=1    # every git commit, with its subject line
TELEGRAM_NOTIFY_PUSH=1      # every git push
TELEGRAM_NOTIFY_TURN=1      # turn finished (subject to MIN_TURN_SECONDS)
TELEGRAM_NOTIFY_WAITING=1   # Claude is blocked on a permission prompt / idle
TELEGRAM_NOTIFY_FAILURE=1   # turn died on a rate limit or API error
